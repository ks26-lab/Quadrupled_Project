<robot name="quadruped_robot">
  <!-- Authoritative Robot Dimensions from Robot_Movement/Robot_Parameters/get_quadruped_geometry.m:
       Body Length = 0.40 m, Width = 0.20 m, Height = 0.12 m, Mass = 5.0 kg
       Thigh Link L1 = 0.12 m, Shank Link L2 = 0.15 m, Standing Height = 0.22 m
       Inertia: J_pitch = 0.05 kg.m^2, Damping B = 0.10 N.m.s/rad
  -->
  <material name="dark_gray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="metallic_blue">
    <color rgba="0.12 0.45 0.85 1.0"/>
  </material>
  <material name="cyan_accent">
    <color rgba="0.0 0.85 0.95 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="orange_sensor">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <!-- Base Link / Trunk -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.12"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0227" ixy="0.0" ixz="0.0" iyy="0.0500" iyz="0.0" izz="0.0607"/>
    </inertial>
  </link>

  <!-- IMU Sensor Marker -->
  <link name="imu_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
      <material name="orange_sensor"/>
    </visual>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LEFT FRONT (LF) LEG ==================== -->
  <link name="lf_hip_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="metallic_blue"/>
    </visual>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lf_q1_roll" type="revolute">
    <parent link="base_link"/>
    <child link="lf_hip_link"/>
    <origin xyz="0.20 0.10 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.785" upper="0.785" effort="10.0" velocity="12.0"/>
  </joint>

  <link name="lf_thigh_link">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.12"/>
      </geometry>
      <material name="cyan_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lf_q2_pitch" type="revolute">
    <parent link="lf_hip_link"/>
    <child link="lf_thigh_link"/>
    <origin xyz="0 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15.0" velocity="12.0"/>
  </joint>

  <link name="lf_shank_link">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.15"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="lf_q3_knee" type="revolute">
    <parent link="lf_thigh_link"/>
    <child link="lf_shank_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.35" effort="15.0" velocity="12.0"/>
  </joint>

  <link name="lf_foot_link">
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="lf_foot_fixed" type="fixed">
    <parent link="lf_shank_link"/>
    <child link="lf_foot_link"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
  </joint>

  <!-- ==================== RIGHT FRONT (RF) LEG ==================== -->
  <link name="rf_hip_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="metallic_blue"/>
    </visual>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="rf_q1_roll" type="revolute">
    <parent link="base_link"/>
    <child link="rf_hip_link"/>
